#!/bin/sh
# Reject assistant attributions in commit messages.
if grep -Eiq 'Generated (with|by) .*(claude|chatgpt|copilot|codex|gemini)|Co-Authored-By:.*(claude|anthropic|openai|copilot|gpt|gemini)|noreply@anthropic\.com' "$1"; then
    echo "ERROR: the commit message contains an assistant attribution." >&2
    exit 1
fi
exit 0
